  "calibration": {
    "microtask_shapes": ["causal-diagnosis", "constraint-decision", "bounded-implementation"],
    "identity_prompt": "Return exactly IDENTITY_OK. Do not call tools.",
    "microtasks": {
      "causal-diagnosis": {
        "prompt": "A durable queue shows rising lag after a deploy. Producer rate and CPU are flat. Worker p95 latency doubled, database lock wait is unchanged, and only workers with clocks more than 20 seconds ahead repeatedly renew leases before processing. Give the most likely mechanism, one competing hypothesis falsified by the observations, and the cheapest discriminating check. Use concise JSON with keys mechanism, falsified, check.",
        "required_keys": ["mechanism", "falsified", "check"]
      },
      "constraint-decision": {
        "prompt": "Choose between an in-memory hash index, an on-disk sorted index, and a streaming scan for a read-once 40 GB input on a host with 2 GB free memory. Existing consumers require input-order output and exact duplicate preservation. State the choice, reject the other two against the constraints, and name one measurement that could reverse the choice. Use concise JSON with keys choice, rejections, measurement.",
        "required_keys": ["choice", "rejections", "measurement"]
      },
      "bounded-implementation": {
        "prompt": "Write a Python function dedupe_committed(events) where each event is a tuple (key, state). Return keys in first-seen order only when a committed state exists. A later aborted state does not remove an earlier commit, and duplicate commits yield one key. Include the function and three assert examples. Do not use external packages.",
        "required_behaviours": ["first-seen-order", "commit-survives-abort", "duplicate-commit-once"]
      }
    },
    "identity_call_cap_usd": 0.25,
    "microtask_call_cap_usd": 1.0,
    "identity_calls": 15,
    "microtask_calls": 45
  }
}
