{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-system/schemas/RoutingDecision.schema.json",
  "title": "RoutingDecision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^rtd-[0-9a-f]{24}$"},
    "task_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_id": {"const": "rigour-auto-v1"},
    "assessment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recommended_action": {"enum": ["worker", "controller", "clarify"]},
    "effective_action": {"enum": ["worker", "controller", "clarify", "blocked"]},
    "selected_cell": {"type": "string", "pattern": "^worker-(sonnet|opus|fable)-(low|medium|high|xhigh|max)$"},
    "controller_profile": {"type": "string", "minLength": 1, "maxLength": 80},
    "override_mode": {"enum": ["auto", "on", "off"]},
    "override_scope": {"enum": ["explicit", "task", "session", "project", "shipped-default"]},
    "override_revision": {"type": "integer", "minimum": 0},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "qualification_status": {"enum": ["qualified", "provisional", "unavailable", "dominated", "budget-blocked"]},
    "cost_range": {"type": "object", "additionalProperties": false, "properties": {
      "currency": {"const": "USD"},
      "minimum": {"type": ["number", "null"], "minimum": 0},
      "expected": {"type": ["number", "null"], "minimum": 0},
      "maximum": {"type": ["number", "null"], "minimum": 0},
      "allowance_cap": {"type": "number", "minimum": 0}
    }, "required": ["currency", "minimum", "expected", "maximum", "allowance_cap"]},
    "remaining_budget": {"type": ["number", "null"], "minimum": 0},
    "next_checkpoint": {"type": "string", "minLength": 1, "maxLength": 100},
    "public_pass_observed": {"type": "boolean"},
    "required_rigour_check_complete": {"type": "boolean"}
  },
  "required": ["decision_version", "decision_id", "task_revision", "policy_id", "assessment_digest", "recommended_action", "effective_action", "selected_cell", "controller_profile", "override_mode", "override_scope", "override_revision", "reason_codes", "evidence_ids", "qualification_status", "cost_range", "remaining_budget", "next_checkpoint", "public_pass_observed", "required_rigour_check_complete"]
}
