+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { syncBuiltinESMExports } from "node:module";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSync } from "node:child_process";
+import { listSourceFiles } from "../src/graph/source-files.js";
+
+for (const git of [false, true]) {
+  test(`scoped enumeration never stats or opens excluded trees (${git ? "Git" : "filesystem"})`, () => {
+    const root = fs.mkdtempSync(join(tmpdir(), "graft-scope-cost-"));
+    const scope = "source space[1]";
+    const excluded = join(root, "excluded");
+    fs.mkdirSync(join(root, scope)); fs.mkdirSync(excluded);
+    fs.writeFileSync(join(root, scope, "new.py"), "def new():\n    return 1\n");
+    fs.writeFileSync(join(root, scope + "-sibling.py"), "def sibling():\n    return 2\n");
+    for (let i = 0; i < 10; i++) fs.writeFileSync(join(excluded, `${i}.py`), "def skip():\n    return 0\n");
+    if (git) execFileSync("git", ["init", "-q"], {cwd:root});
+    const mutable = fs as unknown as Record<string, (...args: unknown[]) => unknown>;
+    const originals = new Map<string, (...args: unknown[]) => unknown>();
+    const visits: string[] = [];
+    for (const name of ["statSync", "lstatSync", "readdirSync"]) {
+      const original = mutable[name]; originals.set(name, original);
+      mutable[name] = (...args) => {
+        if (String(args[0]).startsWith(excluded)) visits.push(String(args[0]));
+        return original(...args);
+      };
+    }
+    syncBuiltinESMExports();
+    try {
+      const files = listSourceFiles(root, join(root,"graft"), undefined, new Set([scope]));
+      assert.deepEqual(files, [join(root,scope,"new.py")]);
+      assert.deepEqual(visits, [], "excluded files must be filtered before filesystem calls");
+    } finally {
+      for (const [name, original] of originals) mutable[name] = original;
+      syncBuiltinESMExports(); fs.rmSync(root,{recursive:true,force:true});
+    }
+  });
+}
