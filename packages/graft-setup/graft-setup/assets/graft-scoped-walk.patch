+/** Segment-aware scope test. Ancestors are admitted only for directory traversal. */
+function inScope(rel: string, onlyDirs?: ReadonlySet<string>, ancestor = false): boolean {
+  if (!onlyDirs?.size) return true;
+  return [...onlyDirs].some((d) => rel === d || rel.startsWith(`${d}/`) ||
+    (ancestor && d.startsWith(`${rel}/`)));
+}
+
+/** Literal pathspecs avoid glob/magic interpretation of user directory names. */
+function scopePathspecs(root: string, onlyDirs?: ReadonlySet<string>, topRoot = root, follow = false): string[] {
+  if (!onlyDirs?.size) return [];
+  const base = relative(topRoot, root).split(sep).join("/");
+  if (base && [...onlyDirs].some((d) => base === d || base.startsWith(`${d}/`))) return [];
+  const paths = [...onlyDirs].filter((d) => !base || d.startsWith(`${base}/`))
+    .map((d) => base ? d.slice(base.length + 1) : d);
+  // A Git child boundary must remain visible when following is opted in.
+  return [...new Set(paths.map((d) => follow ? d.split("/")[0] : d))]
+    .map((d) => `:(top,literal)${d}`);
+}
