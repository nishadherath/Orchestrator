+/** Scope is policy, not a parse cache. A changed extractor must not widen it.
+ * Foreign fingerprints supply only a validated, unanimous whitelist. Their
+ * file hashes and extraction results are never reused. Conflicts fail closed. */
+export function readFingerprintScope(outDir: string): string[] | undefined {
+  const active = readFingerprint(outDir);
+  if (active) return active.onlyDirs;
+  let names: string[];
+  try { names = readdirSync(join(outDir, CACHE_DIR)); } catch { return undefined; }
+  let selected: string[] | undefined;
+  let key: string | undefined;
+  for (const name of names.filter((n) => /^fingerprint\.[^.]+\.json$/.test(n))) {
+    const record = readJson<{version?: number; onlyDirs?: unknown}>(join(outDir, CACHE_DIR, name));
+    if (!record || record.version !== FINGERPRINT_VERSION) continue;
+    const dirs = record.onlyDirs ?? [];
+    if (!Array.isArray(dirs) || dirs.some((d) => typeof d !== "string" || !d ||
+        d.includes("\\") || d.split("/").some((p) => !p || p === "." || p === ".." || p.includes(":")))) {
+      throw new Error("Invalid saved source scope; rebuild with explicit --only-dir choices.");
+    }
+    const normal = [...new Set(dirs as string[])].sort();
+    const next = JSON.stringify(normal);
+    if (key !== undefined && next !== key) throw new Error("Conflicting saved source scopes; rebuild with explicit --only-dir choices.");
+    key = next; selected = normal.length ? normal : undefined;
+  }
+  return selected;
