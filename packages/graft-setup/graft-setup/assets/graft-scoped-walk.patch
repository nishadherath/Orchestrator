+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {mkdtempSync,mkdirSync,writeFileSync,rmSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {readFingerprint,readFingerprintScope} from "../src/graph/fingerprint.js";
+
+test("foreign extractor supplies scope policy without accepting its cached hashes",()=>{
+  const root=mkdtempSync(join(tmpdir(),"graft-scope-upgrade-"));
+  mkdirSync(join(root,".cache"));
+  const write=(name:string,dirs:unknown)=>writeFileSync(join(root,".cache",`fingerprint.${name}.json`),JSON.stringify({version:1,extractor:name,files:{"src/x.py":[1,2,"untrusted"]},onlyDirs:dirs}));
+  try {
+    write("foreign",["tools","src"]);
+    assert.equal(readFingerprint(root),null);
+    assert.deepEqual(readFingerprintScope(root),["src","tools"]);
+    write("older",["src","tools"]);
+    assert.deepEqual(readFingerprintScope(root),["src","tools"]);
+    write("older",["src"]);
+    assert.throws(()=>readFingerprintScope(root),/Conflicting saved source scopes/);
+    write("older",["../outside"]);
+    assert.throws(()=>readFingerprintScope(root),/Invalid saved source scope/);
+  } finally {rmSync(root,{recursive:true,force:true});}
+});
