+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {mkdtempSync,mkdirSync,writeFileSync,readFileSync,statSync,utimesSync,rmSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {buildGraph} from "../src/graph/build.js";
+import {checkGraph} from "../src/graph/check.js";
+import {extractCachePath} from "../src/graph/extract-cache.js";
+
+test("check reuses only same-extractor byte-verified parses; detects same-stat edits, additions and removals",async()=>{
+  const root=mkdtempSync(join(tmpdir(),"graft-check-memo-"));
+  const cache=join(root,"graft"),file=join(root,"src","app.py");
+  mkdirSync(join(root,"src"));writeFileSync(file,"def compute():\n    return 1\n");
+  try {
+    await buildGraph(root,{onlyDirs:["src"],graphOnly:true});
+    const first=await checkGraph(root);
+    assert.equal(first.ok,true);
+    assert.equal((first as unknown as {filesReused:number}).filesReused,1);
+    const independent=await checkGraph(root,{reuse:false});
+    assert.equal(independent.ok,true);assert.equal(independent.filesReused,0);assert.equal(independent.filesParsed,1);
+    const old=statSync(file);
+    writeFileSync(file,"def compute():\n    return 2\n");utimesSync(file,old.atime,old.mtime);
+    assert.equal(statSync(file).size,old.size);
+    const edit=await checkGraph(root);
+    assert.ok(edit.changed.includes("src/app.py#compute"));
+    writeFileSync(join(root,"src","new.py"),"def added():\n    return 3\n");
+    assert.ok((await checkGraph(root)).added.includes("src/new.py#added"));
+    rmSync(file);assert.ok((await checkGraph(root)).removed.includes("src/app.py#compute"));
+    rmSync(join(root,"src","new.py"));writeFileSync(file,"def compute():\n    return 1\n");
+    const path=extractCachePath(cache)!; const memo=JSON.parse(readFileSync(path,"utf8"));
+    memo.files["src/app.py"].nodes=[null];writeFileSync(path,JSON.stringify(memo));
+    assert.equal((await checkGraph(root)).ok,true,"malformed memo must fall back to parsing");
+    memo.files["src/app.py"].nodes=[];writeFileSync(path,JSON.stringify(memo));
+    assert.equal((await checkGraph(root)).ok,true,"memo without its file hash witness must fall back to parsing");
+    memo.extractor="foreign";writeFileSync(path,JSON.stringify(memo));
+    assert.equal((await checkGraph(root)).ok,true,"foreign memo is never accepted");
+  } finally {rmSync(root,{recursive:true,force:true});}
+});
