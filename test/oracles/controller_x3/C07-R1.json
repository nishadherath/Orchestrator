{
  "schema_version": 1,
  "task_id": "C07-R1",
  "diagnosis": "unicode-character-count-shifts-following-frame-boundary",
  "cases": [
    {
      "milestone": "ASCII single frame still roundtrips",
      "weight": 10,
      "critical": false,
      "input": {
        "operation": "roundtrip",
        "messages": [
          "ok"
        ]
      },
      "expected": {
        "messages": [
          "ok"
        ]
      }
    },
    {
      "milestone": "one multibyte message has a valid frame",
      "weight": 30,
      "critical": true,
      "input": {
        "operation": "roundtrip",
        "messages": [
          "é"
        ]
      },
      "expected": {
        "messages": [
          "é"
        ]
      }
    },
    {
      "milestone": "encoded Unicode header counts bytes",
      "weight": 20,
      "critical": false,
      "input": {
        "operation": "encode",
        "messages": [
          "é"
        ]
      },
      "expected": {
        "frame_hex": "0002c3a9"
      }
    },
    {
      "milestone": "following message boundary survives Unicode",
      "weight": 20,
      "critical": false,
      "input": {
        "operation": "roundtrip",
        "messages": [
          "é",
          "ok"
        ]
      },
      "expected": {
        "messages": [
          "é",
          "ok"
        ]
      }
    },
    {
      "milestone": "published multi-frame stream decodes in order",
      "weight": 15,
      "critical": false,
      "input": {
        "operation": "decode",
        "frame_hex": "0002c3a900026f6b"
      },
      "expected": {
        "messages": [
          "é",
          "ok"
        ]
      }
    },
    {
      "milestone": "truncated final header is rejected",
      "weight": 5,
      "critical": false,
      "input": {
        "operation": "decode",
        "frame_hex": "00026f6b00"
      },
      "expected": {
        "error": "invalid_frame"
      }
    }
  ]
}
