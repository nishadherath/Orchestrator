+def _suggest_possibilities(possibilities: cabc.Sequence[str] | None) -> str:
+    """Build a consistent " Did you mean ...?" hint for a set of close
+    name matches, or an empty string if there are none.
+    """
+    if not possibilities:
+        return ""
+
+    if len(possibilities) == 1:
+        return _(" Did you mean '{name}'?").format(name=possibilities[0])
+
+    names = ", ".join(f"'{name}'" for name in sorted(possibilities))
+    return _(" Did you mean one of {names}?").format(names=names)
 
 
