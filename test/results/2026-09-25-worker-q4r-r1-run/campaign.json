              "raw_sha256": "79742b40974889556652c0b382bb7c06a47338404fd8b7ed0b4663865f40a8b3",
              "raw_utf8": "{\"checks\":[{\"command\":\"python3 -B public_check.py\",\"outcome\":\"not_run\"}],\"clarification\":\"I do not have a Bash/terminal tool available in this session to execute `python3 -B public_check.py`. Could you run it (or grant shell access) so the fix can be confirmed?\",\"diagnosis\":\"Site-directory list builders (_site_data_dirs, _site_config_dirs, _site_applications_dirs, macOS _base_site_dirs/_site_cache_dirs) called _append_app_name_and_version with its default create=True, so every candidate site path was created via mkdir even though only one (or a subset under multipath) was actually returned. Iterators in unix.py/macos.py also yielded from these eagerly-built lists, defeating lazy per-item creation.\",\"evidence\":[\"platformdirs/api.py: _append_app_name_and_version now takes create: bool = True, and a new _select_and_create(dirs) helper creates only the entries it returns (dirs[0], or the full list when multipath=True) before joining/selecting.\",\"platformdirs/_xdg.py: _site_data_dirs/_site_config_dirs build candidates with create=False; site_data_dir/site_config_dir/site_applications_dir now delegate to _select_and_create so only the returned path(s) are created.\",\"platformdirs/unix.py: _site_data_dirs/_site_config_dirs build with create=False; site_applications_dir uses _select_and_create; _iter_config_dirs/_iter_data_dirs now create each site path lazily at yield time instead of relying on eager list construction.\",\"platformdirs/macos.py: _base_site_dirs/_site_cache_dirs build with create=False; site_cache_dir/site_applications_dir use _select_and_create; site_state_dir explicitly creates only the single selected entry; _iter_config_dirs/_iter_data_dirs/_iter_cache_dirs create lazily per yielded path.\",\"Manually traced public_check.py scenario: Unix('demo', ensure_exists=True).site_data_dir with XDG_DATA_DIRS='/q3/first:/q3/second' and multipath=False -> _site_data_dirs returns ['/q3/first/demo','/q3/second/demo'] uncreated, _select_and_create creates only '/q3/first/demo' and returns it, matching the asserted value and created list.\"],\"remaining\":[\"No shell/execution tool was available in this session to actually run `python3 -B public_check.py`; the fix was verified by manual code trace only and should be executed to confirm.\"],\"status\":\"partial\"}",
              "report": {
                "checks": [
                  {
                    "command": "python3 -B public_check.py",
                    "outcome": "not_run"
                  }
                ],
                "clarification": "I do not have a Bash/terminal tool available in this session to execute `python3 -B public_check.py`. Could you run it (or grant shell access) so the fix can be confirmed?",
                "diagnosis": "Site-directory list builders (_site_data_dirs, _site_config_dirs, _site_applications_dirs, macOS _base_site_dirs/_site_cache_dirs) called _append_app_name_and_version with its default create=True, so every candidate site path was created via mkdir even though only one (or a subset under multipath) was actually returned. Iterators in unix.py/macos.py also yielded from these eagerly-built lists, defeating lazy per-item creation.",
