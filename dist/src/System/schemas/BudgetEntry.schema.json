{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-system/schemas/BudgetEntry.schema.json",
  "title": "BudgetEntry",
  "description": "Per-invocation reporting projection. dispatch-budget.json owns live Controller admission; this file is rebuilt after recovery. Unknown usage is null. Legacy numeric records remain readable.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "BudgetEntry"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]{3,}$",
      "description": "Record id: a lower-case type prefix, a hyphen, at least three digits. Unique within a run."
    },
    "ledger_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The ledger version this record was written against. A CandidateRecord citing a version other than the frozen one is rejected by the Scribe."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+-[0-9]{3,}$"
      },
      "description": "Ids of the records this one is derived from or responds to. Never edit those records; reference them."
    },
    "phase": {
      "enum": [
        "intake",
        "frame",
        "verify",
        "generate",
        "critique",
        "select",
        "instantiate",
        "close"
      ]
    },
    "role": {
      "enum": [
        "controller",
        "framer",
        "verifier",
        "generator",
        "critic",
        "selector",
        "librarian",
        "b0"
      ]
    },
    "cell": {
      "type": "string",
      "pattern": "^worker-(sonnet|opus|fable)-(low|medium|high|xhigh|max)$"
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tokens_in": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tokens_out": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "wall_clock_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "accounting_status": {
      "enum": [
        "reserved",
        "running",
        "uncertain",
        "settled"
      ]
    },
    "reserved_usd": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "type",
    "id",
    "ledger_version",
    "references",
    "phase",
    "role",
    "cell",
    "cost_usd",
    "tokens_in",
    "tokens_out",
    "wall_clock_s"
  ]
}
